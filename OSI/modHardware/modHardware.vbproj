<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <RootNamespace>modHardware</RootNamespace>
      <UseWindowsForms>true</UseWindowsForms>
   </PropertyGroup>

   <PropertyGroup>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      <Platforms>x64;x86</Platforms>
      <TargetFrameworks>net10.0-windows</TargetFrameworks>
   </PropertyGroup>

   <PropertyGroup Condition="'$(TargetFramework)' != ''">
      <TfmName>$(TargetFramework.Replace('-windows', ''))</TfmName>
      <OutputPath>..\..\bin\$(Configuration)\$(TfmName) $(Platform)\</OutputPath>
      <IntermediateOutputPath>obj\$(Configuration)\$(TfmName) $(Platform)\</IntermediateOutputPath>
   </PropertyGroup>

   <PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(Platform)' == 'x64'">
      <PlatformTarget>$(Platform)</PlatformTarget>
   </PropertyGroup>

   <ItemGroup>
      <Import Include="System.Data" />
      <Import Include="System.Drawing" />
      <Import Include="System.Windows.Forms" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="System.Management" Version="9.0.8" />
   </ItemGroup>

   <ItemGroup>
     <ProjectReference Include="..\SharedInterfaces\SharedInterfaces.vbproj" />
   </ItemGroup>

   <ItemGroup>
     <Compile Update="frmBaseBoard.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmBaseBoardBIOS.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmBattery.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmDiskDrive.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmKeyBoard.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmMemory.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmProcessor.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="ModResources.Designer.vb">
       <DesignTime>True</DesignTime>
       <AutoGen>True</AutoGen>
       <DependentUpon>ModResources.resx</DependentUpon>
     </Compile>
   </ItemGroup>

   <ItemGroup>
     <EmbeddedResource Update="ModResources.resx">
       <CustomToolNamespace>My.Resources</CustomToolNamespace>
       <Generator>ResXFileCodeGenerator</Generator>
       <LastGenOutput>ModResources.Designer.vb</LastGenOutput>
     </EmbeddedResource>
     <EmbeddedResource Update="My Project\Resources.resx">
       <CustomToolNamespace>My.Resources</CustomToolNamespace>
       <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
       <LastGenOutput>Resources.Designer.vb</LastGenOutput>
     </EmbeddedResource>
   </ItemGroup>

</Project>
