<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <RootNamespace>modWindows</RootNamespace>
      <UseWindowsForms>true</UseWindowsForms>
   </PropertyGroup>

<PropertyGroup>
   <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
   <Platforms>x64;x86</Platforms>
   <TargetFrameworks>net10.0-windows</TargetFrameworks>
</PropertyGroup>

<PropertyGroup Condition="'$(TargetFramework)' != ''">
   <TfmName>$(TargetFramework.Replace('-windows', ''))</TfmName>
   <OutputPath>..\..\bin\$(Configuration)\$(TfmName) $(Platform)\</OutputPath>
   <IntermediateOutputPath>obj\$(Configuration)\$(TfmName) $(Platform)\</IntermediateOutputPath>
</PropertyGroup>

<PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(Platform)' == 'x64'">
   <PlatformTarget>$(Platform)</PlatformTarget>
</PropertyGroup>
   
   <ItemGroup>
      <Import Include="System.Data" />
      <Import Include="System.Drawing" />
      <Import Include="System.Windows.Forms" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="System.Management" Version="9.0.8" />
   </ItemGroup>

   <ItemGroup>
     <ProjectReference Include="..\SharedInterfaces\SharedInterfaces.vbproj" />
   </ItemGroup>

   <ItemGroup>
     <Compile Update="frmEnvironment.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmOperatingSystem.vb">
       <SubType>Form</SubType>
     </Compile>
     <Compile Update="frmUserAccount.vb">
       <SubType>Form</SubType>
     </Compile>
   </ItemGroup>
   
</Project>
